          "id": "f707ad9d-1ec7-4d39-a89b-66043f2844bc",
          "name": "Get all attendance records",
          "request": {
            "name": "Get all attendance records",
            "description": {
              "content": "<p>This API is used for fetching list of all attendance records between from and to date. If both from and to are not specified, last 30 days records are returned. From date should be before to date.The difference between from and to date cannot be more than 90 days.</p>\n<h2 id=\"enumerated-values\">Enumerated Values</h2>\n<div class=\"click-to-expand-wrapper is-table-wrapper\"><table>\n<thead>\n<tr>\n<th>AttendanceDayType</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>0 = WorkingDay  <br />1 = Holiday  <br />2 = FullDayWeeklyOff  <br />3 = FirstHalfWeeklyOff  <br />4 = SecondHalfWeeklyOff</td>\n</tr>\n</tbody>\n</table>\n</div>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "time",
                "attendance"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Keka tenant subdomain",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                }
              ]
            },
            "method": "GET",
            "auth": null
          },
